DATABASE_URL=sqlite:///./zzrise.db
# Generate a unique private key with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ZZZRISE_SECRET_KEY=replace-this-with-a-unique-random-secret
# Keep false for local HTTP development. Set true only when deployed behind HTTPS.
COOKIE_SECURE=false
ENVIRONMENT=development

# Local AI: no OpenAI/Groq API key is required.
# Install Ollama and download a model, e.g. `ollama pull qwen2.5:3b`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Keep false for same-computer Ollama. Set true only if you intentionally trust a remote Ollama host.
OLLAMA_ALLOW_REMOTE=false
